# =========================================================================
# FractalNova · esempio di configurazione. Copia in `.env` e compila.
#   cp .env.example .env
# =========================================================================

# =========================================================================
# FractalNova · esempio di configurazione. Copia in `.env` e compila.
#   cp .env.example .env
# =========================================================================

# ── Profilo FractalNova (unico) ─────────────────────────────────
FRACTALNOVA_PROFILE=pro                  # pro | core
FRACTALNOVA_PRO_MODEL=models/Qwen3-4B    # path locale modelli scaricati
FRACTALNOVA_PRO_ADAPTER=                 # path checkpoint QLoRA fine-tunato
FRACTALNOVA_CORE_MODEL=models/fractalnova-core-124m
FRACTALNOVA_MAX_SEQ_LEN=8192

# ── Vision (Gemma-4-E2B) ────────────────────────────────────────
GEMMA4_MODEL_ID=models/gemma-4-E2B

# ── Copertine (FLUX.1-dev) ──────────────────────────────────────
FLUX_MODEL_ID=models/FLUX.1-dev

# ── HuggingFace (download modelli) ──────────────────────────────
HF_TOKEN=

# ── Autore (firma proposte editoriali) ─────────────────────────
AUTHOR_NAME=
AUTHOR_EMAIL=

# ── SMTP (outreach editori) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENABLE_AUTO_OUTREACH=false

# ── Server ──────────────────────────────────────────────────────
FRACTALNOVA_HOST=0.0.0.0
FRACTALNOVA_PORT=7860
CORS_ORIGINS=
API_SECRET=
MAX_CONTENT_LENGTH_MB=10
RATE_LIMIT=30
RATE_WINDOW_SEC=600

# ── Legacy (modelli precedenti, per compatibilità) ──────────────
QWEN_LOCAL_MODEL_PATH=training/outputs/fractalnova-pro-merged
ALLOW_TRUST_REMOTE_CODE=false
DEEPSEEK_LOCAL_PATH=models/DeepSeek-V3
LLAMA_LOCAL_MODEL_PATH=models/Meta-Llama-3-8B-Instruct
GEMMA_LOCAL_MODEL_PATH=models/Gemma-7B
